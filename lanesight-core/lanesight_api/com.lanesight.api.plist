<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference copy of the LaneSight Mac API LaunchAgent. The AUTHORITATIVE plist is generated by
     lanesight_api/service.sh (it fills in your real checkout path), so prefer:
         lanesight_api/service.sh install     # write + load + start
         lanesight_api/service.sh status      # loaded? running? + /health
     This file documents what that produces. NOTE: the repo must live OUTSIDE ~/Documents, ~/Desktop and
     ~/Downloads — macOS TCC blocks launchd background jobs from reading those. Canonical path: ~/Developer/LaneSight.
     caffeinate -s keeps the Mac awake for the API's lifetime; serve.sh binds the tailnet IP (live Supabase);
     secrets come from the Keychain at runtime — none are stored here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lanesight.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>/Users/shaynel/Developer/LaneSight/lanesight-core/lanesight_api/serve.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/shaynel/Developer/LaneSight/lanesight-core</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/shaynel</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/shaynel/LaneSightData/logs/api.out.log</string>
  <key>StandardErrorPath</key><string>/Users/shaynel/LaneSightData/logs/api.err.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
