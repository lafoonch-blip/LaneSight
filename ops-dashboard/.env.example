# LaneSight ops dashboard — environment. Copy to .env.local and fill in. NEVER commit real secrets.
# The dashboard fails closed: if these are unset it serves NO ACCESS / refuses login, it never shows data.

# Supabase project the dashboard reports on (the live project: europwryibstnmipbvam).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SERVICE ROLE key — bypasses RLS, reads the owner-only ops_* views. SERVER-ONLY. Never prefix NEXT_PUBLIC_.
# This is the same secret bound to Cloud Run as LANESIGHT_SERVICE_ROLE.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Owner auth gate (interim, single-owner). Login requires this token; the session cookie is an HMAC of it.
OPS_DASHBOARD_TOKEN=choose-a-long-random-owner-token
OPS_DASHBOARD_SECRET=choose-a-second-long-random-string-for-cookie-signing
