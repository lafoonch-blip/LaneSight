# LaneSight ops dashboard — environment. Copy to .env.local and fill in.
# NONE of these are secrets: the anon/publishable key is designed to ship to the browser, and the owner id
# is a uuid. There is NO service_role / JWT secret / DB password here — the dashboard reads data only via
# owner-checked RPCs, authenticated as the owner. Safe to set as plain Vercel env vars.

# LaneSight Supabase project (live: europwryibstnmipbvam).
NEXT_PUBLIC_SUPABASE_URL=https://europwryibstnmipbvam.supabase.co

# Publishable (anon) key — client-safe. From Supabase project API settings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Owner user id — MUST equal owner.py OWNER_USER_ID and ops.app_owner. Server-side gate (the DB re-checks).
OPS_OWNER_ID=551bc775-dee4-41bd-a19c-116e8691d053
